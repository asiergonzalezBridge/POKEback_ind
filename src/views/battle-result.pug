extends layout

block variables
    - var pageClass = 'battle-page'

block links
    link(rel="stylesheet" href="/battle.css")

block title
    title Resultado - PokéBack

block content
    .battle-result
        case result.result
            when 'win'
                span.result-icon 🏆
                h2.result-title.win ¡Victoria!
                p.result-subtitle +20 monedas añadidas a tu cuenta
            when 'captured'
                span.result-icon 🔴
                h2.result-title.captured ¡Capturado!
                p.result-subtitle #{result.enemy} se unió a tu colección
            when 'loss'
                span.result-icon 💀
                h2.result-title.loss Derrota
                p.result-subtitle Tu Pokémon ha muerto para siempre
            when 'flee'
                span.result-icon 🏃
                h2.result-title.flee Escapaste
                p.result-subtitle Sin recompensa

        .result-log
            each line in result.log
                p › #{line}

        .result-actions
            a.btn-battle(href="/battle") Volver a batallar
            a.btn-secondary(href="/pokemon") Ver mis Pokémon